# Variables de entorno para la infraestructura ShareSplit
# Copia este archivo a .env y ajusta los valores

# PostgreSQL
POSTGRES_USER=sharesplit
POSTGRES_PASSWORD=sharesplit_secret
POSTGRES_DB=sharesplit
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=3001
JWT_SECRET=reemplaza_esto_con_un_secreto_seguro_de_al_menos_32_chars
JWT_EXPIRES_IN=7d

# CORS — URL del frontend (ajusta según entorno)
CORS_ORIGIN=http://localhost:3000
